# v58 · F5: app/ obsahuje jen soubory, které vkládá index.php. Přímý přístup zakázán.
<IfModule mod_authz_core.c>
    Require all denied
    <!-- SEC59-01: hlubší <FilesMatch> vyhrává nad kořenovým allowlistem PHP skriptů. -->
    <FilesMatch ".">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch ".">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
