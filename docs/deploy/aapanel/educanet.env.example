# EDUCANET v59 · prostředí pro CLI a cron na aaPanelu – is.stanektech.cz
#
# Na serveru:  /www/server/educanet/educanet.env   (vlastník root:www, práva 0640)
# PHP-FPM tenhle soubor NEČTE – webu stejné hodnoty předává educanet-rules.conf
# (fastcgi_param). Při změně uprav OBA soubory a proveď reload nginx.
# Používají ho: deploy_aapanel.sh, educanet-cron.sh a ruční příkazy
#   set -a; . /www/server/educanet/educanet.env; set +a; php tools/...
# a tools/preflight.php --env-file=/www/server/educanet/educanet.env
#
# Žádné secrety sem nepatří – ty jsou v /www/server/educanet/educanet.secrets.php.

EDUCANET_APP_URL=https://is.stanektech.cz
EDUCANET_HSTS=0
EDUCANET_TIMEZONE=Europe/Prague
EDUCANET_SECRETS_FILE=/www/server/educanet/educanet.secrets.php
EDUCANET_BACKUP_DIR=/www/educanet-backup

# Záložní adresář musí být zapisovatelný pro uživatele `www` (0750).
# Nepoužívej /www/backup/educanet – ten aaPanel drží jen pro roota a `www` do něj nezapíše.

# PRODUKČNÍ STAV: bez účtů učitelů web vrátí 503 místo tichého návratu ke starému sdílenému klíči.
# Jen při úplně prvním nasazení (než existuje admin, docs/NASAZENI_AAPANEL.md §3 krok 1) řádek
# dočasně zakomentuj a po `create-admin` ho vrať – tady I v educanet-rules.conf.
EDUCANET_TEACHER_ACCOUNTS_REQUIRED=1

# --- NIKDY v produkci (preflight hlásí FAIL) ---------------------------------------
#EDUCANET_DEV_BYPASS=1
#EDUCANET_ALLOW_FREE_CLASS_ENTRY=1
#EDUCANET_LOCAL_AUTH_REQUIRE_EMAIL_VERIFY=0
