# EDUCANET v59 · vzorové produkční prostředí
#
# Zkopíruj do /etc/educanet.env (mimo web root, čitelné jen pro uživatele PHP-FPM
# poolu a roota), nastav skutečné hodnoty a načti ho:
#   - v PHP-FPM poolu:  env[EDUCANET_APP_URL] = https://skola.example (jedna direktiva na proměnnou), NEBO
#   - v systemd unitu PHP-FPM: EnvironmentFile=/etc/educanet.env, NEBO
#   - v cron úlohách:  set -a; . /etc/educanet.env; set +a; php tools/...
#
# tools/preflight.php --env-file=/etc/educanet.env dokáže tento soubor přečíst
# i mimo běžící FPM (CLI proces jinak vidí jen své vlastní prostředí).
#
# NIKDY needávej tento soubor s reálnými hodnotami do gitu/vydání – je to jen šablona.

# --- Povinné / silně doporučené ---------------------------------------------
EDUCANET_APP_URL=https://skola.example
# HSTS (Strict-Transport-Security, 1 rok, includeSubDomains) – aplikace hlavičku
# posílá jen přes HTTPS. SEC59-13: výchozí je VYPNUTO (0) – zapnout (1) až po ověření,
# že celá doména školy VČETNĚ VŠECH SUBDOMÉN běží trvale jen přes HTTPS (jinak
# subdoména bez TLS přestane fungovat v prohlížečích, které si HSTS zapamatovaly;
# nevratné dokud nevyprší max-age).
EDUCANET_HSTS=0
# Absolutní cesta MIMO web root (ISPConfig: .../private/educanet.secrets.php,
# aaPanel: /www/server/educanet/educanet.secrets.php). Zkopíruj a uprav
# educanet.secrets.example.php na tomto místě, nebo použij EDUCANET_TEACHER_EXPORT_KEY níže.
EDUCANET_SECRETS_FILE=/var/www/clients/client1/web1/private/educanet.secrets.php
# Alternativa/doplněk k souboru se secrety – dlouhý náhodný řetězec (>= 32 znaků),
# NIKDY jedna z testovacích hodnot z INSTALL.md.
# SEC59-05: jakmile běží učitelské účty (v59, po `tools/v59_teacher_accounts.php
# create-admin`), tenhle klíč se pro přihlášení na teacher.php ani pro CSV export
# (export_extra_csv.php) už NEPOUŽÍVÁ – zruš ho/rotuj a místo něj nastav
# EDUCANET_TEACHER_ACCOUNTS_REQUIRED=1 níže.
#EDUCANET_TEACHER_EXPORT_KEY=

# SEC59-05: jakmile má škola vytvořený aspoň jeden učitelský administrátorský účet,
# nastav na 1 – aplikace pak v accounts režimu při chybějícím souboru účtů vrátí 503
# místo tichého pádu zpět do legacy režimu se sdíleným klíčem.
#EDUCANET_TEACHER_ACCOUNTS_REQUIRED=1

# Záloha storage/ – adresář MIMO web root.
EDUCANET_BACKUP_DIR=/var/backups/educanet

# Časové pásmo (mělo by odpovídat lokalitě školy).
EDUCANET_TIMEZONE=Europe/Prague

# --- Volitelné ----------------------------------------------------------------
# Google Workspace přihlášení (jen pokud škola používá školní Google účty).
#EDUCANET_GOOGLE_CLIENT_ID=
#EDUCANET_GOOGLE_DOMAIN=skola.example

# Odesílatel systémových e-mailů (reset hesla, ověření). Vyžaduje funkční MTA
# na serveru se SPF/DKIM pro doménu.
#EDUCANET_MAIL_FROM=EDUCANET <no-reply@skola.example>

# Přesměrování úložiště mimo docroot – nastavuj JEN vědomě (výchozí storage/ je
# už chráněná .htaccess, ale mimo docroot je to jistota navíc).
#EDUCANET_STORAGE_DIR=/var/www/educanet-data/storage

# Externí AI tutor (jen pokud škola tuto integraci schválí – data žáků by šla
# mimo server školy).
#EDUCANET_TUTOR_ENDPOINT=
#EDUCANET_TUTOR_TOKEN=
#EDUCANET_TUTOR_MODEL=

# --- NIKDY nenastavovat v produkci (preflight na ně hlásí FAIL, pokud jsou) ---
#EDUCANET_DEV_BYPASS=1
#EDUCANET_ALLOW_FREE_CLASS_ENTRY=1
#EDUCANET_LOCAL_AUTH_REQUIRE_EMAIL_VERIFY=0
#EDUCANET_LAB_BROKER_URL=
#EDUCANET_LAB_BROKER_TOKEN=
