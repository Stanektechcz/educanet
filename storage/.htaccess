# Živá data žáků – nikdy přes web.
<IfModule mod_authz_core.c>
    Require all denied
    <!-- SEC59-01: hlubší <FilesMatch> vyhrává nad kořenovým allowlistem PHP skriptů
         (Apache slučuje <FilesMatch> ze všech .htaccess po cestě k adresáři,
         např. storage/intake/index.php by jinak matchoval "^(index|...)\.php$"). -->
    <FilesMatch ".">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch ".">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
