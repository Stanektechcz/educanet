# Interní soubory – nikdy přes web (tools/ a tests/ jsou jen pro CLI).
<IfModule mod_authz_core.c>
    Require all denied
    <!-- SEC59-01: hlubší <FilesMatch> vyhrává nad kořenovým allowlistem PHP skriptů. -->
    <FilesMatch ".">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch ".">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
